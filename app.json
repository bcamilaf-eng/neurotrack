{
  "expo": {
    "name": "NeuroTrack",
    "slug": "neurotrack",
    "scheme": "neurotrack",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.neurotrack.mobile",
      "infoPlist": {
        "NSFaceIDUsageDescription": "NeuroTrack usa Face ID para proteger tu registro de salud."
      }
    },
    "android": {
      "package": "app.neurotrack.mobile",
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#E8EEFB",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_HEIGHT",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_HYDRATION",
        "android.permission.health.READ_MENSTRUATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "NeuroTrack usa Face ID para proteger tu registro de salud."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ]
  }
}
